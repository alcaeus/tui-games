{
    "name": "alcaeus/tui-games",
    "description": "Collection of CLI games to be used in Symfony TUI applications",
    "type": "library",
    "require": {
        "php": "^8.4",
        "symfony/tui": "8.1.x"
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0",
        "phpunit/phpunit": "^13.3",
        "symfony/process": "^7.2"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Alcaeus\\TuiGames\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alcaeus\\TuiGames\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Andreas Braun",
            "email": "git@alcaeus.org"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
